<?php
// ================================================================
//  GERADOR DE CONTEÃšDO BÃBLICO â€” Proxy Seguro para OpenAI
// ================================================================
//
//  1. Substitua SUA_CHAVE_AQUI pela sua chave real (sk-proj-...)
//  2. Ajuste ALLOWED_ORIGINS com os domÃ­nios do seu site
//  3. Salve como proxy/openai.php no servidor
//
// ================================================================

define('OPENAI_API_KEY', 'sk-proj-SUA_CHAVE_AQUI');

// DomÃ­nios autorizados (sem barra final). Ajuste conforme seu domÃ­nio.
define('ALLOWED_ORIGINS', implode(',', [
    'http://sermao.jdafotografia.com.br',
    'https://sermao.jdafotografia.com.br',
    // 'http://localhost:5173',   // descomente apenas em testes locais
]));

// SeguranÃ§a: limite mÃ¡ximo de tokens por requisiÃ§Ã£o (previne gastos excessivos)
define('MAX_TOKENS_CAP', 8000);

// Rate limit: mÃ¡ximo de requisiÃ§Ãµes por IP por janela de tempo
define('RATE_LIMIT_MAX',    80);   // requisiÃ§Ãµes permitidas
define('RATE_LIMIT_WINDOW', 300);  // janela em segundos (5 minutos)

// ================================================================
//  NÃƒO EDITAR ABAIXO DESTA LINHA
// ================================================================

// â”€â”€ 1. VerificaÃ§Ã£o da chave â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if (OPENAI_API_KEY === 'sk-proj-SUA_CHAVE_AQUI' || empty(OPENAI_API_KEY)) {
    http_response_code(500);
    header('Content-Type: application/json');
    echo json_encode([
        'error' => [
            'message' => 'Chave da OpenAI nÃ£o configurada. Edite proxy/openai.php.',
            'type'    => 'configuration_error',
        ]
    ]);
    exit();
}

// â”€â”€ 2. CORS â€” verifica origem â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$allowedOrigins = array_map('trim', explode(',', ALLOWED_ORIGINS));
$origin         = isset($_SERVER['HTTP_ORIGIN']) ? $_SERVER['HTTP_ORIGIN'] : '';
$corsOrigin     = !empty($origin) ? $origin : $allowedOrigins[0];

if (!empty($origin) && !in_array($origin, $allowedOrigins, true)) {
    http_response_code(403);
    header('Content-Type: application/json');
    echo json_encode(['error' => ['message' => 'Origem nÃ£o autorizada.', 'type' => 'forbidden']]);
    exit();
}

// PrÃ©-flight CORS (responde antes dos outros headers SSE)
if ($_SERVER['REQUEST_METHOD'] === 'OPTIONS') {
    http_response_code(204);
    header('Access-Control-Allow-Origin: ' . $corsOrigin);
    header('Access-Control-Allow-Headers: Content-Type, Authorization');
    header('Access-Control-Allow-Methods: POST, OPTIONS');
    header('Vary: Origin');
    exit();
}

// â”€â”€ 3. Apenas POST â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    header('Content-Type: application/json');
    echo json_encode(['error' => ['message' => 'MÃ©todo nÃ£o permitido.']]);
    exit();
}

// â”€â”€ 4. Rate limiting por IP (compatÃ­vel com PHP 7.0+) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$ip      = isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : 'unknown';
$ipHash  = md5($ip);
$tmpFile = sys_get_temp_dir() . '/sermao_rl_' . $ipHash . '.json';
$now     = time();
$window  = $now - RATE_LIMIT_WINDOW;

$rl = array('requests' => array());
if (file_exists($tmpFile)) {
    $decoded = json_decode(file_get_contents($tmpFile), true);
    if (is_array($decoded)) $rl = $decoded;
}

// Remove registros fora da janela (sem arrow function â€” compatÃ­vel PHP 7.0+)
$filtered = array();
foreach ($rl['requests'] as $t) {
    if ($t > $window) $filtered[] = $t;
}
$rl['requests'] = $filtered;

if (count($rl['requests']) >= RATE_LIMIT_MAX) {
    http_response_code(429);
    header('Content-Type: application/json');
    echo json_encode([
        'error' => [
            'message' => 'Muitas requisiÃ§Ãµes. Aguarde alguns minutos e tente novamente.',
            'type'    => 'rate_limit_exceeded',
        ]
    ]);
    exit();
}

$rl['requests'][] = $now;
@file_put_contents($tmpFile, json_encode($rl), LOCK_EX);

// â”€â”€ 5. ValidaÃ§Ã£o e saneamento do body â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Este plano descarta POST acima de ~16 KB. O app manda o JSON compactado
// (gzip) ou em partes pequenas, para o corpo caber nesse limite.
$rawBody = file_get_contents('php://input');
if (!is_string($rawBody)) $rawBody = '';

if (strlen($rawBody) >= 2 && substr($rawBody, 0, 2) === "\x1f\x8b") {
    $decoded = @gzdecode($rawBody);
    if (!is_string($decoded) || $decoded === '' || strlen($decoded) > 1500000) {
        http_response_code(400);
        header('Content-Type: application/json');
        echo json_encode(['error' => ['message' => 'NÃ£o foi possÃ­vel ler o pedido compactado.']]);
        exit();
    }
    $rawBody = $decoded;
}

if ($rawBody === '') {
    http_response_code(400);
    header('Content-Type: application/json');
    echo json_encode(['error' => ['message' => 'RequisiÃ§Ã£o vazia.']]);
    exit();
}

$payload = json_decode($rawBody, true);

if (is_array($payload) && isset($payload['_chunk']) && is_array($payload['_chunk'])) {
    $chunk = $payload['_chunk'];
    $id = isset($chunk['id']) ? preg_replace('/[^a-f0-9]/', '', (string) $chunk['id']) : '';
    if (!is_string($id) || strlen($id) < 8) {
        http_response_code(400);
        header('Content-Type: application/json');
        echo json_encode(['error' => ['message' => 'Parte do pedido invÃ¡lida.']]);
        exit();
    }
    $base = sys_get_temp_dir() . '/sermao_chk_' . $id;
    $total = isset($chunk['n']) ? (int) $chunk['n'] : 0;
    if (!empty($chunk['finish'])) {
        if ($total < 1 || $total > 40) {
            http_response_code(400);
            header('Content-Type: application/json');
            echo json_encode(['error' => ['message' => 'Pedido incompleto.']]);
            exit();
        }
        $rawBody = '';
        for ($i = 0; $i < $total; $i++) {
            $partFile = $base . '_' . $i;
            $part = @file_get_contents($partFile);
            @unlink($partFile);
            if (!is_string($part) || $part === '') {
                http_response_code(400);
                header('Content-Type: application/json');
                echo json_encode(['error' => ['message' => 'Faltou uma parte do pedido.']]);
                exit();
            }
            $rawBody .= $part;
        }
        $payload = json_decode($rawBody, true);
    } else {
        $index = isset($chunk['i']) ? (int) $chunk['i'] : -1;
        $data = isset($chunk['data']) ? (string) $chunk['data'] : '';
        if ($index < 0 || $index > 39 || $total < 1 || $total > 40 || $data === '') {
            http_response_code(400);
            header('Content-Type: application/json');
            echo json_encode(['error' => ['message' => 'Parte do pedido invÃ¡lida.']]);
            exit();
        }
        @file_put_contents($base . '_' . $index, $data, LOCK_EX);
        header('Content-Type: application/json');
        echo json_encode(['ok' => true]);
        exit();
    }
}

if (!is_array($payload) || !isset($payload['messages']) || !is_array($payload['messages'])) {
    http_response_code(400);
    header('Content-Type: application/json');
    echo json_encode(['error' => ['message' => 'Formato de requisiÃ§Ã£o invÃ¡lido.']]);
    exit();
}

// ForÃ§ar modelo permitido e limitar tokens (impede abusos de custo)
$payload['model']      = 'gpt-4o';
$payload['max_tokens'] = min((int)(isset($payload['max_tokens']) ? $payload['max_tokens'] : MAX_TOKENS_CAP), MAX_TOKENS_CAP);

// Limitar nÃºmero de mensagens
if (count($payload['messages']) > 10) {
    http_response_code(400);
    header('Content-Type: application/json');
    echo json_encode(['error' => ['message' => 'NÃºmero de mensagens excede o limite.']]);
    exit();
}

$isStreaming = !empty($payload['stream']) && $payload['stream'] === true;
$safeBody    = json_encode($payload);

// â”€â”€ 6. Headers â€” SSE para streaming, JSON para respostas normais â”€
header('Access-Control-Allow-Origin: ' . $corsOrigin);
header('Access-Control-Allow-Headers: Content-Type, Authorization');
header('Access-Control-Allow-Methods: POST, OPTIONS');
header('Vary: Origin');

if ($isStreaming) {
    header('Content-Type: text/event-stream');
    header('Cache-Control: no-cache');
    header('X-Accel-Buffering: no');
}

// â”€â”€ 7. Encaminha para a OpenAI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
$ch = curl_init('https://api.openai.com/v1/chat/completions');

curl_setopt($ch, CURLOPT_POST,           true);
curl_setopt($ch, CURLOPT_POSTFIELDS,     $safeBody);
curl_setopt($ch, CURLOPT_HTTPHEADER,     [
    'Content-Type: application/json',
    'Authorization: Bearer ' . OPENAI_API_KEY,
]);
curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
curl_setopt($ch, CURLOPT_TIMEOUT,        120);
curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true);

if ($isStreaming) {
    // Streaming: ecoa os chunks SSE em tempo real
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, false);
    curl_setopt($ch, CURLOPT_WRITEFUNCTION, function ($ch, $data) {
        echo $data;
        if (ob_get_level() > 0) ob_flush();
        flush();
        return strlen($data);
    });
    $success = curl_exec($ch);
} else {
    // NÃ£o-streaming: acumula e devolve JSON
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    $responseBody = curl_exec($ch);
    $success      = $responseBody !== false;
    if ($success) {
        header('Content-Type: application/json');
        echo $responseBody;
    }
}

if (!$success) {
    http_response_code(502);
    header('Content-Type: application/json');
    echo json_encode([
        'error' => [
            'message' => 'Erro ao conectar com a OpenAI: ' . curl_error($ch),
            'type'    => 'proxy_error',
        ]
    ]);
}

curl_close($ch);
