Options -MultiViews
RewriteEngine On

# ── Proxy de API (encaminha chamadas do app para o PHP seguro) ──
# Caminho relativo + END: um destino com barra inicial (/proxy/openai.php)
# vira redirect interno e o Apache descarta o corpo do POST (400 Requisição vazia).
RewriteRule ^proxy/v1/.*$ proxy/openai.php [QSA,END]

# ── SPA — todas as rotas vão para o index.html ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]
